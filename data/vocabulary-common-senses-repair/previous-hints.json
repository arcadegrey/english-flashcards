  "5451": [
    {
      "label": "近义词辨析",
      "scope": "动词 · 喜欢、从中获得乐趣",
      "emphasis": "enjoy",
      "text": "enjoy：like 可表达一般喜好；enjoy 常强调某项活动或经历带来的乐趣。enjoy 后接动作时用 -ing 形式，不直接接 to do。",
      "examples": [
        {
          "en": "I like short stories with surprising endings.",
          "zh": "我喜欢结尾出人意料的短篇故事。"
        },
        {
          "en": "We enjoy reading them aloud after dinner.",
          "zh": "我们喜欢在晚饭后大声读这些故事。"
        }
      ],
      "exampleWords": [
        "like",
        "enjoy"
      ],
      "sources": [
        {
          "id": "daily-enjoy",
