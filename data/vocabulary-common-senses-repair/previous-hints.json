  "5596": [
    {
      "label": "近义词辨析",
      "scope": "形容词 · 待人友善",
      "emphasis": "friendly",
      "text": "friendly：kind 强调体贴、愿意帮助别人；friendly 强调交往时亲切友好。本条不适用于 kind 作名词表示“种类”的用法。",
      "examples": [
        {
          "en": "It was kind of Ben to carry my heavy bag upstairs.",
          "zh": "本帮我把沉重的包提上楼，真体贴。"
        },
        {
          "en": "The receptionist gave every visitor a friendly greeting.",
          "zh": "接待员友好地问候了每位来访者。"
        }
      ],
      "exampleWords": [
        "kind",
        "friendly"
      ],
