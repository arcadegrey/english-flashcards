  "groups": {
    "expansion50-9027": {
      "words": [
        "thank you"
      ],
      "comparisonType": "usage",
      "sense": "phr. · 谢谢；感谢你",
      "note": "用于表达感谢；thank you for 后接名词或 -ing。不要与有连字符的名词 thank-you 混为一谈。",
      "examples": [
        {
          "en": "Thank you for the lovely flowers.",
          "zh": "谢谢你送来漂亮的花。"
        },
        {
          "en": "Thank you for waiting outside.",
          "zh": "谢谢你在外面等候。"
        }
      ],
      "sourceIds": [
        "expansion50-9027"
      ],
      "review": {
        "status": "source-checked",
        "checkedAt": "2026-10-29"
      }
    },
    "expansion50-9028": {
      "words": [
        "you're welcome"
      ],
      "comparisonType": "usage",
      "sense": "phr. · 不客气（回应感谢）",
      "note": "回应他人的感谢；you're 是 you are 的缩写，此处 welcome 不是欢迎客人的动词。",
      "examples": [
        {
          "en": "You're welcome, and please visit us again.",
          "zh": "不客气，欢迎你再来。"
        },
        {
          "en": "You're welcome, and I hope the map helps.",
          "zh": "不客气，希望这张地图能帮上忙。"
        }
      ],
      "sourceIds": [
        "expansion50-9028"
      ],
      "review": {
        "status": "source-checked",
        "checkedAt": "2026-10-29"
      }
    },
    "expansion50-9029": {
      "words": [
        "how are you"
      ],
      "comparisonType": "usage",
      "sense": "phr. · 你好吗（问候语）",
      "note": "问候对方近况；日常答语可以很简短。how are you feeling 可具体询问感受或身体状况。",
      "examples": [
        {
          "en": "How are you after your long trip?",
          "zh": "长途旅行之后，你感觉怎么样？"
        },
        {
          "en": "How are you doing at your new school?",
          "zh": "你在新学校过得怎么样？"
        }
      ],
      "sourceIds": [
        "expansion50-9029"
      ],
      "review": {
        "status": "source-checked",
        "checkedAt": "2026-10-29"
      }
    },
    "expansion50-9030": {
      "words": [
        "i'm sorry"
      ],
      "comparisonType": "usage",
      "sense": "phr. · 对不起；我很遗憾",
      "note": "可用于道歉，也可表示同情；I'm sorry about 后接事情，I'm sorry to hear that 表示听到坏消息很遗憾。",
      "examples": [
        {
          "en": "I'm sorry about the noise last night.",
          "zh": "昨晚的噪音真是对不起。"
        },
        {
          "en": "I'm sorry to hear that your dog is ill.",
          "zh": "听说你的狗病了，我很难过。"
        }
      ],
      "sourceIds": [
        "expansion50-9030"
      ],
      "review": {
        "status": "source-checked",
        "checkedAt": "2026-10-29"
      }
    },
    "expansion50-9031": {
      "words": [
        "how about"
      ],
      "comparisonType": "usage",
      "sense": "phr. · ……怎么样（提出建议或询问）",
      "note": "提出建议时可接名词或 -ing；How about you? 可把同一个问题转问对方。",
      "examples": [
        {
          "en": "How about a picnic by the lake?",
          "zh": "去湖边野餐怎么样？"
        },
        {
          "en": "How about meeting after lunch?",
          "zh": "午饭后见面怎么样？"
        }
      ],
      "sourceIds": [
        "expansion50-9031"
      ],
      "review": {
        "status": "source-checked",
        "checkedAt": "2026-10-29"
      }
    },
    "expansion50-9032": {
      "words": [
        "what about"
      ],
      "comparisonType": "usage",
      "sense": "phr. · ……怎么样；那么……呢",
      "note": "可提出建议，也可追问尚未处理的事；后接名词或 -ing，不机械等同于 What is。",
      "examples": [
        {
          "en": "What about having dinner together?",
          "zh": "一起吃晚饭怎么样？"
        },
        {
          "en": "What about your sister's ticket?",
          "zh": "那你姐姐的票呢？"
        }
      ],
      "sourceIds": [
        "expansion50-9032"
      ],
      "review": {
        "status": "source-checked",
        "checkedAt": "2026-10-29"
      }
    },
    "expansion50-9033": {
      "words": [
        "would you like"
      ],
      "comparisonType": "usage",
      "sense": "phr. · 你想要……吗（礼貌提议或邀请）",
      "note": "would you like 后接名词或 to do；邀请某人做事时保留 to，区别于询问一般喜好的 Do you like。",
      "examples": [
        {
          "en": "Would you like to sit by the window?",
          "zh": "你想坐在窗边吗？"
        },
        {
          "en": "Would you like another slice of bread?",
          "zh": "你还想要一片面包吗？"
        }
      ],
      "sourceIds": [
        "expansion50-9033"
      ],
      "review": {
        "status": "source-checked",
        "checkedAt": "2026-10-29"
      }
    },
    "expansion50-9034": {
      "words": [
        "right now"
      ],
      "comparisonType": "usage",
      "sense": "adv. · 现在；立刻",
      "note": "表示就在此刻，也可强调立刻行动；按语境区分当前状态与马上执行。",
      "examples": [
        {
          "en": "The children are at school right now.",
          "zh": "孩子们现在在学校。"
        },
        {
          "en": "We need to leave right now.",
          "zh": "我们需要立刻出发。"
        }
      ],
      "sourceIds": [
        "expansion50-9034"
      ],
      "review": {
        "status": "source-checked",
        "checkedAt": "2026-10-29"
      }
    },
    "expansion50-9035": {
      "words": [
        "look at"
      ],
      "comparisonType": "usage",
      "sense": "v. · 看；注视；查看",
      "note": "look at 后接所看的对象；look 强调把视线转过去，see 可表示看见的结果。",
      "examples": [
        {
          "en": "We can look at the menu together.",
          "zh": "我们可以一起看看菜单。"
        },
        {
          "en": "Please look at both sides of the coin.",
          "zh": "请看看硬币的两面。"
        }
      ],
      "sourceIds": [
        "expansion50-9035"
      ],
      "review": {
        "status": "source-checked",
        "checkedAt": "2026-10-29"
      }
    },
    "expansion50-9036": {
      "words": [
        "wake up"
      ],
      "comparisonType": "usage",
      "sense": "v. · 醒来；叫醒",
      "note": "可不带宾语表示醒来，也可叫醒他人；代词放中间，如 wake him up。",
      "examples": [
        {
          "en": "Please wake me up at six.",
          "zh": "请六点叫醒我。",
          "forms": [
            {
              "word": "wake up",
              "form": "wake me up",
              "sourceIds": [
                "expansion50-9036"
              ],
              "review": {
                "status": "source-checked",
                "checkedAt": "2026-10-29"
              }
            }
          ]
        },
        {
          "en": "The birds wake up when the sun rises.",
          "zh": "太阳升起时，鸟儿醒来。"
        }
      ],
      "sourceIds": [
        "expansion50-9036"
      ],
      "review": {
        "status": "source-checked",
        "checkedAt": "2026-10-29"
      }
    },
    "expansion50-9037": {
      "words": [
        "i think so"
      ],
      "comparisonType": "usage",
      "sense": "phr. · 我想是的；我认为如此",
      "note": "用 so 代替前面提到的看法，表示倾向于赞同；通常比直接肯定更保留。",
      "examples": [
        {
          "en": "I think so, but we should ask the teacher.",
          "zh": "我想是的，不过我们应该问问老师。"
        },
        {
          "en": "I think so, because the lights are still on.",
          "zh": "我想是的，因为灯还亮着。"
        }
      ],
      "sourceIds": [
        "expansion50-9037"
      ],
      "review": {
        "status": "source-checked",
        "checkedAt": "2026-10-29"
      }
    },
    "expansion50-9038": {
      "words": [
        "in the middle"
      ],
      "comparisonType": "usage",
      "sense": "adv. · 在中间；在……期间（常接 of）",
      "note": "可指位置居中；in the middle of 后接地点、事件或进行中的活动。",
      "examples": [
        {
          "en": "Put the small bowl in the middle.",
          "zh": "把小碗放在中间。"
        },
        {
          "en": "The phone rang in the middle of dinner.",
          "zh": "晚饭吃到一半时，电话响了。"
        }
      ],
      "sourceIds": [
        "expansion50-9038"
      ],
      "review": {
        "status": "source-checked",
        "checkedAt": "2026-10-29"
      }
    },
    "expansion50-9039": {
      "words": [
        "as long as"
      ],
      "comparisonType": "usage",
      "sense": "条件连词与比较结构 · 只要；与……一样长（或久）",
      "note": "条件义后接完整从句；也可比较长度或时间，不能在所有句子里都译成只要。",
      "examples": [
        {
          "en": "You may stay as long as you keep quiet.",
          "zh": "只要保持安静，你就可以留下。"
        },
        {
          "en": "This rope is as long as that one.",
          "zh": "这根绳子和那根一样长。"
        }
      ],
      "sourceIds": [
        "expansion50-9039"
      ],
      "review": {
        "status": "source-checked",
        "checkedAt": "2026-10-29"
      }
    },
