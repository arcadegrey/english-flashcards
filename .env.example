# Runtime speech uses pre-generated word/example recordings and browser speech.
# No live Kokoro/Railway endpoint is used. npm run tts:kokoro is an offline
# authoring tool for generating recordings, not a browser playback dependency.

# Optional static word audio base. Keep empty for same-origin /audio/words.
# For R2/CDN, use a public base URL without the trailing voice/id filename.
# VITE_WORD_AUDIO_BASE_URL=https://audio.englishflashcards.cn/audio/words

# Optional static example sentence audio base. Keep empty for same-origin /audio/examples.
# For R2/CDN, use a public base URL without the trailing voice/id filename.
# VITE_EXAMPLE_AUDIO_BASE_URL=https://audio.englishflashcards.cn/audio/examples

# Versioned correction/replacement audio. Defaults to the production audio domain.
# VITE_AUDIO_UPDATES_BASE_URL=https://audio.englishflashcards.cn/audio-updates

# Local R2 upload helper. Keep secrets in your shell, not in committed env files.
# R2_AUDIO_BUCKET=english-flashcards-audio
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Optional API base (default uses same-origin /api on Cloudflare Worker)
# VITE_API_BASE=/api
VITE_API_BASE=/api
